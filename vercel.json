{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/", "destination": "/frontend/html/home.html" },
    { "source": "/(css|js|assets)/(.*)", "destination": "/frontend/$1/$2" },
    { "source": "/(.*\\.html)", "destination": "/frontend/html/$1" }
  ]
}
